  "narrative": {
    "northStar": "The Clear Reference Desk",
    "overview": "A clear, calm, technical system that puts documentation ahead of interface decoration. Strong Urbanist headings establish signposts; system-font prose and compact supporting controls keep sustained reading familiar. The purple folded-D artwork carries identity without replacing the blue interaction palette.\n\nComponents are precise and restrained. The workspace is flat, while selected utilities are lifted: borders and cool neutral layers organize persistent regions; small shadows distinguish link cards and larger shadows separate overlays. Light and dark are complete semantic themes, not simple color inversion.",
    "keyCharacteristics": [
      "Heavy geometric headings with familiar system-font prose.",
      "Blue interaction accents and cool neutral surfaces in both themes.",
      "Persistent desktop wayfinding that collapses for smaller screens.",
      "Flat content regions, restrained borders, and selectively lifted utilities.",
      "Existing folded-D identity artwork, not a generalized gradient treatment."
    ],
    "rules": [
      {
        "name": "The Semantic Theme Rule",
        "body": "Use the active theme's semantic CSS properties for text, backgrounds, borders, and accents; token names such as “white” and “black” describe roles that change with the theme.",
        "section": "colors"
      },
      {
        "name": "The Heading/Prose Rule",
        "body": "Preserve Urbanist for headings and the site title; use the system stack for body text and ordinary controls. Card titles have their own weight-600 treatment and should not be mistaken for document headings.",
        "section": "typography"
      },
      {
        "name": "The Utility Lift Rule",
        "body": "Keep reading surfaces flat. Reuse the implemented small, medium, and large shadow roles for the utilities that already need separation rather than adding ambient shadows to every container.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** resolve semantic color properties for the active light or dark theme.",
      "**Do** preserve the Urbanist heading/system-prose distinction.",
      "**Do** keep reading content bounded and preserve mobile navigation and horizontal code overflow.",
      "**Do** retain visible keyboard focus and current-page or selected-state semantics.",
      "**Do** use existing folded-D artwork for identity and semantic colors for contextual signals."
    ],
    "donts": [
      "**Don't** equate the purple logo artwork with the blue interaction accent.",
      "**Don't** give every content region a shadow or the same corner radius.",
      "**Don't** invent hover motion, form states, or additional palette roles absent from the implementation.",
      "**Don't** describe this extracted design record or historical screenshots as proof of complete Starlight parity."
    ]
  }
}
